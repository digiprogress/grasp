# Grasp local environment configuration.
# Copy to .env and edit as needed.

# ArcadeDB root password (used by both graph and consumers).
# NOTE: ArcadeDB requires at least 8 characters — set a real value.
ARCADEDB_ROOT_PASSWORD=change-me-to-something-secure

ARCADEDB_URL=http://localhost:2480
ARCADEDB_DATABASE=grasp
ARCADEDB_USER=root

# Parser HTTP endpoint (used by the MCP server to trigger parses).
# Host default when the MCP runs outside docker-compose:
PARSER_URL=http://127.0.0.1:3334
# Inside the docker network use: http://grasp-parser:3334
